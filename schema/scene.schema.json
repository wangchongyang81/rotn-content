{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rotn/scene",
  "type": "object",
  "required": ["id", "realmId", "kind", "beats"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "realmId": { "type": "integer", "minimum": 1, "maximum": 34 },
    "kind": { "enum": ["intro", "encounter", "cg", "boss", "ambient"] },
    "npc": { "type": "string" },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["text"],
        "additionalProperties": false,
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "speaker": { "type": "string" },
          "tone": { "enum": ["neutral", "warm", "cold", "wry", "tense"] }
        }
      }
    }
  }
}
